# NetHunter features, merged after raphael_defconfig and docker.config.
# The USB gadget functions for HID, RNDIS and mass storage attacks are already in raphael_defconfig.
# Everything is built in (=y) because the boot image installs no modules. Exceptions (=m):
# - mac80211_hwsim: built in, it would create fake Wi-Fi radios at every boot.
# - ath9k_htc: its htc_start, htc_stop and htc_connect_service clash with the same names
#   in the built-in Qualcomm Wi-Fi driver (qca-wifi-host-cmn), so the kernel does not link.

# Wi-Fi stack for USB adapters, fake radios for practice, two common adapter drivers
CONFIG_MAC80211=y
CONFIG_MAC80211_HWSIM=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y

# USB serial devices: Arduino, ESP32 boards, M5Stack Cardputer, Flipper Zero, UART adapters
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y

# Bluetooth serial links (BT-Arsenal) and USB Bluetooth dongles
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_HCIBTUSB=y
